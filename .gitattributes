* text=auto

*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.xml text eol=lf

*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.png binary
*.ttf binary
*.webp binary

# Large product media is stored through Git LFS.
assets/products/**/*.pdf filter=lfs diff=lfs merge=lfs -text
assets/products/**/*.webp filter=lfs diff=lfs merge=lfs -text
