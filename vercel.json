{
  "buildCommand": "node scripts/build-static-site.mjs",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "regions": ["dub1"],
  "functions": {
    "api/merchant-feed.mjs": { "maxDuration": 60 }
  },
  "redirects": [
    { "source": "/payment", "destination": "/delivery#payment", "statusCode": 301 },
    { "source": "/payment.html", "destination": "/delivery#payment", "statusCode": 301 },
    { "source": "/heating.html", "destination": "/catalog/heating", "statusCode": 301 },
    { "source": "/heating", "destination": "/catalog/heating", "statusCode": 301 },
    { "source": "/water-supply.html", "destination": "/catalog/water-supply", "statusCode": 301 },
    { "source": "/water-supply", "destination": "/catalog/water-supply", "statusCode": 301 },
    { "source": "/plumbing.html", "destination": "/catalog", "permanent": false },
    { "source": "/plumbing", "destination": "/catalog", "permanent": false },
    { "source": "/catalog/plumbing", "destination": "/catalog", "permanent": false },
    { "source": "/climate.html", "destination": "/catalog/climate", "statusCode": 301 },
    { "source": "/climate", "destination": "/catalog/climate", "statusCode": 301 },
    { "source": "/catalog.html", "missing": [{ "type": "query", "key": "category", "value": "(?<legacySection>heating|water|treatment|automation|climate)" }], "destination": "/catalog", "statusCode": 301 },
    { "source": "/brands.html", "destination": "/brands", "statusCode": 301 },
    { "source": "/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/catalog/index.html", "destination": "/catalog", "statusCode": 301 },
    { "source": "/:page(about|account|blog|brand|buyers|cart|checkout|compare|contact|delivery|faq|favorites|installation|partnership|portfolio|post|privacy|product|returns|search|service-center|services|solutions|terms|warranty).html", "destination": "/:page", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/catalog", "has": [{ "type": "query", "key": "category", "value": "(?<legacySection>heating|water|treatment|automation|climate)" }], "destination": "/api/seo-page?kind=catalog&legacySection=:legacySection" },
    { "source": "/catalog.html", "has": [{ "type": "query", "key": "category", "value": "(?<legacySection>heating|water|treatment|automation|climate)" }], "destination": "/api/seo-page?kind=catalog&legacySection=:legacySection" },
    { "source": "/catalog", "destination": "/catalog.html" },
    { "source": "/catalog/water-treatment", "has": [{ "type": "query", "key": "type", "value": "(?<legacyType>reverse-osmosis|flow-filters|mainline-filters|water-filter-cartridges|mainline-cartridges|filter-media|horeca)" }], "destination": "/api/seo-page?kind=catalog&path=water-treatment&legacyType=:legacyType" },
    { "source": "/catalog/:path(.+)/index.html", "destination": "/api/seo-page?kind=catalog&legacyPath=1&path=:path" },
    { "source": "/catalog/:path(.+)", "destination": "/api/seo-page?kind=catalog&path=:path" },
    { "source": "/brands/:slug/index.html", "destination": "/api/seo-page?kind=brand&legacyPath=1&slug=:slug" },
    { "source": "/brands/:slug", "destination": "/api/seo-page?kind=brand&slug=:slug" },
    { "source": "/blog/:slug", "destination": "/api/seo-page?kind=post&postKind=article&slug=:slug" },
    { "source": "/portfolio/:slug", "destination": "/api/seo-page?kind=post&postKind=case&slug=:slug" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/brand", "has": [{ "type": "query", "key": "slug", "value": "(?<legacyBrand>.+)" }], "destination": "/api/seo-page?kind=brand&legacyPath=1&slug=:legacyBrand" },
    { "source": "/brand", "destination": "/brand.html" },
    { "source": "/brands", "destination": "/brands.html" },
    { "source": "/buyers", "destination": "/buyers.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/compare", "destination": "/compare.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/delivery", "destination": "/delivery.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/favorites", "destination": "/favorites.html" },
    { "source": "/installation", "destination": "/installation.html" },
    { "source": "/partnership", "destination": "/partnership.html" },
    { "source": "/portfolio", "destination": "/portfolio.html" },
    { "source": "/post", "destination": "/post.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/product", "has": [{ "type": "query", "key": "id", "value": "(?<legacyId>.+)" }], "destination": "/api/seo-page?kind=product&id=:legacyId" },
    { "source": "/product", "destination": "/product.html" },
    { "source": "/products/:slug/index.html", "destination": "/api/seo-page?kind=product&legacyPath=1&slug=:slug" },
    { "source": "/products/:slug", "destination": "/api/seo-page?kind=product&legacyPath=1&slug=:slug" },
    { "source": "/product/:slug", "destination": "/api/seo-page?kind=product&slug=:slug" },
    { "source": "/returns", "destination": "/returns.html" },
    { "source": "/search", "destination": "/search.html" },
    { "source": "/service-center", "destination": "/service-center.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/solutions", "destination": "/solutions.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/warranty", "destination": "/warranty.html" },
    { "source": "/google-merchant.xml", "destination": "/api/merchant-feed" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-hashes' 'sha256-9gOBGqEQINNDuds+tkXbNzih6klbz+KeCyxEj4KRLeM=' 'sha256-aahron4TcYhEQN+dHyp69SFrmNVCc1Uwxs04qY5sD1Y=' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://vercel.live; connect-src 'self' https://api.novaposhta.ua https://fkjarsouuchjiedrrblc.supabase.co https://wfxcklglujgramasdzyr.supabase.co https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.facebook.com https://connect.facebook.net https://vercel.live wss://ws-us3.pusher.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://www.google.com https://maps.google.com https://www.googletagmanager.com https://vercel.live; worker-src 'self' blob:; manifest-src 'self'; form-action 'self' mailto:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/:page(account|cart|checkout|compare|favorites|search|post)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/:file*.:ext(js|mjs|css)",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
