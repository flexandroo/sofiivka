{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/catalog.html", "has": [{ "type": "query", "key": "category", "value": "heating" }], "destination": "/catalog/heating", "permanent": true },
    { "source": "/catalog.html", "has": [{ "type": "query", "key": "category", "value": "water" }], "destination": "/catalog/water-supply", "permanent": true },
