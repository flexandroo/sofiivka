    { "source": "/catalog/water-treatment", "has": [{ "type": "query", "key": "type", "value": "water-filter-cartridges" }], "destination": "/catalog/water-supply/water-treatment/drinking-system-cartridges", "permanent": true },
    { "source": "/catalog/water-treatment", "has": [{ "type": "query", "key": "type", "value": "mainline-cartridges" }], "destination": "/catalog/water-supply/water-treatment/mainline-cartridges", "permanent": true },
