    { "source": "/catalog/water-treatment/:category", "destination": "/catalog/water-supply/water-treatment/:category", "permanent": true },
    { "source": "/catalog/water-treatment", "destination": "/catalog/water-supply/water-treatment", "permanent": true },
    { "source": "/heating.html", "destination": "/catalog/heating", "permanent": true },
    { "source": "/heating", "destination": "/catalog/heating", "permanent": true },
    { "source": "/water-supply.html", "destination": "/catalog/water-supply", "permanent": true },
    { "source": "/water-supply", "destination": "/catalog/water-supply", "permanent": true },
    { "source": "/plumbing.html", "destination": "/catalog/plumbing", "permanent": true },
